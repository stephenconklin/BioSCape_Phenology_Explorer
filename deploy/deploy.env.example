# BioSCape Phenology Explorer — deployment configuration
#
# Copy to deploy.env and edit, then:  sudo ./deploy/bootstrap.sh
# (deploy.env is gitignored — it may hold host-specific detail.)

# ---------------------------------------------------------------------------
# Hostname / TLS
# ---------------------------------------------------------------------------
# Public DNS name pointed at this instance's floating IP.
# Leave EMPTY to serve plain HTTP on the bare IP.
#
# Let's Encrypt CANNOT issue a certificate for a bare IP address, so TLS is
# skipped automatically unless this is a real hostname.
SERVER_NAME=""

# Contact address for Let's Encrypt expiry notices. Required only when
# SERVER_NAME is set and ENABLE_TLS=yes.
CERTBOT_EMAIL=""

# Obtain a certificate via certbot. Ignored when SERVER_NAME is empty.
ENABLE_TLS="yes"

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# Host directory holding the datacubes / pixel_metrics.nc / basemap .npz caches.
# Bind-mounted read-only into the container at /data.
#
# The bootstrap script does NOT create or populate this — the datacubes are
# tens of GB and must be attached as a Jetstream2 volume and copied in
# separately.  The script verifies the path and fails loudly if it is missing
# or empty.  See deploy/README.md.
DATA_ROOT="/media/volume/Bioscape_Dashboard_Data/phenology_data"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Where the repo is checked out on the host.
APP_DIR="/opt/bioscape-phenology-explorer"

REPO_URL="https://github.com/stephenconklin/BioSCape_Phenology_Explorer.git"
REPO_BRANCH="main"

# Container memory cap. Leave headroom for the host OS and sshd — on a 6GB
# m3.small, 5g leaves ~1GB. Without a cap, an OOM event lets the host kernel
# choose the victim, which could be sshd rather than the container.
MEM_LIMIT="5g"

# ---------------------------------------------------------------------------
# Host provisioning toggles
# ---------------------------------------------------------------------------
# Swapfile size as an OOM safety net. Set to "0" to skip. Containers get host
# swap by default unless --memory-swap is explicitly capped, which it is not.
SWAP_SIZE="2G"

# Enable the ufw firewall (SSH + nginx only).
# Verify SSH access from a second terminal before trusting this.
ENABLE_UFW="yes"

# Install the health sampler cron job (every 2 min → ~/dashboard-watch/health.log).
ENABLE_HEALTH_SAMPLER="yes"
